{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/:path((?!wp-content/|wp-includes/|robots\.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/wp-(content|includes)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}

